#!/bin/bash
# Makes the self-signed code-signing certificate that bin/build-slotbar signs SlotBar with, in the
# login keychain, unless it's already there. A stable identity keeps SlotBar's Accessibility grant
# across rebuilds; an ad-hoc signature changes with every build and loses it.
# Run once per Mac. The private key exists outside the keychain only in a temp dir removed on exit.
set -euo pipefail
name="SlotBar Local Signing"
keychain="$HOME/Library/Keychains/login.keychain-db"

if security find-certificate -c "$name" "$keychain" >/dev/null 2>&1; then
  echo "$name: already in the login keychain"
  exit 0
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
# macOS's own LibreSSL writes a PKCS#12 that `security import` reads; OpenSSL 3+ would need -legacy.
/usr/bin/openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -subj "/CN=$name" \
  -keyout "$work/key.pem" -out "$work/cert.pem" \
  -addext "keyUsage=critical,digitalSignature" -addext "extendedKeyUsage=critical,codeSigning" \
  -addext "basicConstraints=critical,CA:false" 2>/dev/null
pass=$(/usr/bin/openssl rand -hex 16)
/usr/bin/openssl pkcs12 -export -inkey "$work/key.pem" -in "$work/cert.pem" -name "$name" \
  -passout "pass:$pass" -out "$work/identity.p12"
security import "$work/identity.p12" -k "$keychain" -P "$pass" -T /usr/bin/codesign >/dev/null
echo "$name: created in the login keychain."
echo "The first build may ask to let codesign use the key; choose Always Allow."
