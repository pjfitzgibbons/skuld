#!/bin/bash
# Builds SlotBar (macos/slotbar/) with the Command Line Tools' swiftc into macos/build/SlotBar.app,
# with the slotbar-pulse command inside it beside SlotBar, where `plan pulse` finds the installed
# copy. Signs both and prints the bundle's path.
set -euo pipefail
root=$(cd "$(dirname "$(realpath "$0")")/.." && pwd)
src="$root/macos/slotbar"
out="$root/macos/build"
app="$out/SlotBar.app"

identity="SlotBar Local Signing"

# macOS shows a menu-bar extra only from a signed bundle (SK-0043). The stable identity from
# bin/slotbar-signing-identity keeps the Accessibility grant across rebuilds; without it, the build
# falls back to ad-hoc signing, and each rebuild needs the grant renewed.
sign() {
  if security find-certificate -c "$identity" >/dev/null 2>&1; then
    codesign -s "$identity" --force "$1" 2>/dev/null
  else
    echo "build-slotbar: no \"$identity\" certificate, signing ad-hoc; run bin/slotbar-signing-identity once" >&2
    codesign -s - --force "$1" 2>/dev/null
  fi
}

rm -rf "$app"
mkdir -p "$app/Contents/MacOS"
cp "$src/Info.plist" "$app/Contents/Info.plist"
swiftc -O -parse-as-library -o "$app/Contents/MacOS/SlotBar" "$src/SlotCore.swift" "$src/slotbar.swift"
swiftc -O -parse-as-library -o "$app/Contents/MacOS/slotbar-pulse" "$src/SlotCore.swift" "$src/pulse.swift"
# A second executable in Contents/MacOS is nested code: it's signed before the bundle around it.
sign "$app/Contents/MacOS/slotbar-pulse"
sign "$app"
echo "$app"
