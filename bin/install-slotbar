#!/bin/bash
# Builds and signs SlotBar, installs it to ~/Applications with its LaunchAgent so it starts at
# login and restarts after a crash, starts it, and reports whether macOS placed its menu-bar item.
#   install-slotbar [<slots file>]   install, or reinstall over a running one
#   install-slotbar --uninstall      stop it and remove the app and the agent
set -euo pipefail
root=$(cd "$(dirname "$(realpath "$0")")/.." && pwd)
label=dev.skuld.slotbar
app="$HOME/Applications/SlotBar.app"
agent="$HOME/Library/LaunchAgents/$label.plist"
log="$HOME/Library/Logs/SlotBar.log"
domain="gui/$(id -u)"

stopAgent() {
  launchctl bootout "$domain/$label" 2>/dev/null || true
  pkill -x SlotBar 2>/dev/null || true
}

uninstall() {
  stopAgent
  rm -f "$agent"
  rm -rf "$app"
  echo "SlotBar removed. Its Menu Bar approval stays in System Settings → Menu Bar until removed there."
}

writeAgent() {
  local slots=$1
  mkdir -p "$(dirname "$agent")" "$(dirname "$log")"
  cat > "$agent" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key><array>
    <string>$app/Contents/MacOS/SlotBar</string>
    <string>$slots</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>$log</string>
  <key>StandardErrorPath</key><string>$log</string>
</dict></plist>
PLIST
}

# SlotBar logs its item's frame each time it changes; height 0 means macOS hasn't placed it.
# Placement can take a second or two after launch, so this waits for a placed line.
reportPlacement() {
  for _ in $(seq 1 20); do
    if tail -n 5 "$log" 2>/dev/null | grep -q "placed=true"; then
      echo "SlotBar is in the menu bar."
      return 0
    fi
    perl -e 'select(undef,undef,undef,0.5)'
  done
  echo "SlotBar is running, but macOS hasn't placed its item in the menu bar." >&2
  echo "Allow SlotBar under System Settings → Menu Bar, and set the menu bar to never hide (GUIDE §2)." >&2
  return 1
}

install() {
  local slots=${1:-$HOME/.cache/plan/workspaces}
  local built; built=$("$root/bin/build-slotbar")
  stopAgent
  mkdir -p "$HOME/Applications"
  rm -rf "$app"
  cp -R "$built" "$app"
  writeAgent "$slots"
  : > "$log"
  launchctl bootstrap "$domain" "$agent"
  echo "SlotBar installed: $app, agent $agent, log $log"
  reportPlacement
}

case "${1:-}" in
  --uninstall) uninstall ;;
  *) install "$@" ;;
esac
