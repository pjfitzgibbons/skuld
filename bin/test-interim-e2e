#!/bin/bash
# Runs the interim's end-to-end suite: the 12 checks of docs/adr/0005-redmine-is-the-tracker.md §3.9
# against the Redmine instance. It is the gate that ends the interim, so it exits non-zero until
# skuld's Ruby core works. Settings are in ~/.config/skuld/interim-e2e.json (lib/interim_config.py
# lists the keys); the API keys come from the Keychain on each run.
#   bin/test-interim-e2e              run all 12 checks
#   bin/test-interim-e2e <config>     use another settings file
# Its offline tests: python3 -m unittest lib.test_interim_e2e
set -euo pipefail
root=$(cd "$(dirname "$(realpath "$0")")/.." && pwd)
cd "$root"
exec python3 -c 'import sys; from lib.interim_e2e import main; sys.exit(main())' "$@"
