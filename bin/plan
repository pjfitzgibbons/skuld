#!/usr/bin/env python3
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from lib.cli import main

if __name__ == "__main__":
    try:
        sys.exit(main() or 0)
    except Exception as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
